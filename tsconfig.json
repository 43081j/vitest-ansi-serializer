{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": [],
    "declaration": true,
    "outDir": "./lib",
    "rootDir": "./src",
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "erasableSyntaxOnly": true,
    "isolatedDeclarations": true
  },
  "include": [
    "src/**/*.ts"
  ]
}
